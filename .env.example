# App
PORT=3003

# Database
DB_HOST=<pooler-host>
DB_PORT=6543
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<password>
DB_NAME=postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
DIRECT_CONNECTION_STRING=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Auth
JWT_ACCESS_SECRET=<replace-with-long-random-secret>
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=<replace-with-long-random-secret>
JWT_REFRESH_EXPIRES_IN=7d
JWT_SECRET=<optional-legacy-jwt-secret>

# Cloudflare R2
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_ACCOUNT_ID=<r2-account-id>
R2_BUCKET_NAME=<r2-bucket-name>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=<optional-public-r2-url>

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:3003/auth/google/callback
GOOGLE_FRONTEND_REDIRECT=http://localhost:5173/auth/callback

# Supabase public project metadata
PROJECT_URL=https://<project-ref>.supabase.co
PUBLISHABLE_KEY=<supabase-publishable-key>

# Internal services
AI_SERVICE_URL=http://localhost:9000
